FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
PORT=5000

# API Configuration
API_KEY_REQUIRED=False
API_KEY=your-api-key-here
API_RATE_LIMIT=100
CORS_ORIGINS=*

# Data Source Configuration
# Options: mock, csv, api, database
# mock: Use generated test data (default for development)
# csv: Load data from CSV file
# api: Fetch data from Survey Solutions API
# database: Load from PostgreSQL/MySQL database
DATA_SOURCE=mock

# CSV Data Configuration (if DATA_SOURCE=csv)
CSV_FILE_PATH=data/survey_data.csv

# Survey Solutions API Configuration (if DATA_SOURCE=api)
SS_API_USER=api_user
SS_API_PASSWORD=your-survey-solutions-password

# Database Configuration (if DATA_SOURCE=database)
# DATABASE_URL=postgresql://user:password@localhost/vanuatu_survey
# Example for MySQL: mysql+pymysql://user:password@localhost/vanuatu_survey
